.8px;\n      }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"bl-wrap\">\n    <div class=\"bl-app\">\n      <div class=\"bl-bar\">\n        <div class=\"bl-logo\">\n          <svg viewbox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"m18.2 3.3a1.2 1.2 0 0 1 0 1.7l-1.5 1.5h1.8a3 3 0 0 1 3 3v8.2a3 3 0 0 1-3 3h-13a3 3 0 0 1-3-3v-8.2a3 3 0 0 1 3-3h1.8l-1.5-1.5a1.2 1.2 0 1 1 1.7-1.7l3.2 3.2h.6l3.2-3.2a1.2 1.2 0 0 1 1.7 0zm-.1 6.4h-12.2a1 1 0 0 0-1 1v6.4a1 1 0 0 0 1 1h12.2a1 1 0 0 0 1-1v-6.4a1 1 0 0 0-1-1zm-8.8 2.3v2.6a.8.8 0 0 1-1.6 0v-2.6a.8.8 0 0 1 1.6 0zm7.2 0v2.6a.8.8 0 0 1-1.6 0v-2.6a.8.8 0 0 1 1.6 0z\"></path></svg>\n          哔哩哔哩\n          <small>bilibili</small>\n        </div>\n        <div class=\"bl-spacer\"></div>\n        <button class=\"bl-chip hide\" id=\"bl-change\" type=\"button\">换源</button>\n      </div>\n\n      <div id=\"bl-stage\" class=\"bl-stage hidden\"></div>\n      <div id=\"bl-body\" class=\"bl-body\"></div>\n    </div>\n  </div>\n\n  <script>\n    (function () {\n      \"use strict\";\n\n      var injected = \"{{$1}}\";\n      var stage = document.getElementById(\"bl-stage\");\n      var body = document.getElementById(\"bl-body\");\n      var changeBtn = document.getElementById(\"bl-change\");\n\n      var meta = null;\n      var currentSource = null;\n\n      var storeKeyLast = \"bl_memory_last_source_v2\";\n      var storeKeyRecent = \"bl_memory_recent_sources_v2\";\n\n      function esc(s) {\n        return String(s == null ? \"\" : s)\n          .replace(/&/g, \"&amp;\")\n          .replace(/</g, \"&lt;\")\n          .replace(/>/g, \"&gt;\")\n          .replace(/\"/g, \"&quot;\")\n          .replace(/'/g, \"&#39;\");\n      }\n\n      function fmt(n) {\n        n = Number(n) || 0;\n        return n >= 10000 ? (n / 10000).toFixed(1) + \"万\" : String(n);\n      }\n\n      function picHttps(p) {\n        p = String(p || \"\");\n        if (!p) return \"\";\n        if (p.indexOf(\"//\") === 0) return \"https:\" + p;\n        return p.replace(/^http:/i, \"https:\");\n      }\n\n      function extract(raw) {\n        raw = String(raw || \"\").replace(/^\\s+|\\s+$/g, \"\");\n        if (!raw) return null;\n\n        var bv = raw.match(/bv[0-9a-z]+/i);\n        if (bv && bv[0].length >= 10) {\n          return { type: \"bvid\", id: bv[0] };\n        }\n\n        var av = raw.match(/av(\\d+)/i);\n        if (av) {\n          return { type: \"aid\", id: av[1] };\n        }\n\n        return null;\n      }\n\n      function sourceText(src) {\n        if (!src) return \"\";\n        return src.type === \"bvid\" ? src.id : \"av\" + src.id;\n      }\n\n      function playerUrl(src) {\n        var base = \"https://player.bilibili.com/player.html?page=1&high_quality=1&as_wide=1&autoplay=0&danmaku=1\";\n        return src.type === \"bvid\"\n          ? base + \"&bvid=\" + encodeURIComponent(src.id)\n          : base + \"&aid=\" + encodeURIComponent(src.id);\n      }\n\n      function storageGet(key, fallback) {\n        try {\n          var v = localStorage.getItem(key);\n          if (v == null) return fallback;\n          return JSON.parse(v);\n        } catch (e) {\n          return fallback;\n        }\n      }\n\n      function storageSet(key, value) {\n        try {\n          localStorage.setItem(key, JSON.stringify(value));\n        } catch (e) {}\n      }\n\n      function remember(src, title) {\n        if (!src) return;\n\n        var item = {\n          type: src.type,\n          id: src.id,\n          title: title || sourceText(src),\n          time: Date.now()\n        };\n\n        storageSet(storeKeyLast, item);\n\n        var list = storageGet(storeKeyRecent, []);\n        if (!Array.isArray(list)) list = [];\n\n        list = list.filter(function (x) {\n          return !(x && x.type === item.type && String(x.id).toLowerCase() === String(item.id).toLowerCase());\n        });\n\n        list.unshift(item);\n        list = list.slice(0, 2);\n\n        storageSet(storeKeyRecent, list);\n      }\n\n      function getLast() {\n        var item = storageGet(storeKeyLast, null);\n        if (!item || !item.type || !item.id) return null;\n        return item;\n      }\n\n      function getRecent() {\n        var list = storageGet(storeKeyRecent, []);\n        if (!Array.isArray(list)) return [];\n        return list.filter(function (x) {\n          return x && x.type && x.id;\n        }).slice(0, 2);\n      }\n\n      function itemToSrc(item) {\n        return { type: item.type, id: item.id };\n      }\n\n      function loadView(src) {\n        return new Promise(function (resolve, reject) {\n          var cb = \"__bl_view_\" + Date.now() + \"_\" + Math.floor(Math.random() * 100000);\n          var timer = null;\n          var script = document.createElement(\"script\");\n\n          function clean() {\n            if (timer) clearTimeout(timer);\n            try {\n              delete window[cb];\n            } catch (e) {\n              window[cb] = null;\n            }\n            if (script && script.parentNode) {\n              script.parentNode.removeChild(script);\n            }\n          }\n\n          window[cb] = function (data) {\n            clean();\n            resolve(data);\n          };\n\n          timer = setTimeout(function () {\n            clean();\n            reject(new Error(\"timeout\"));\n          }, 8000);\n\n          script.onerror = function () {\n            clean();\n            reject(new Error(\"error\"));\n          };\n\n          var q = src.type === \"bvid\"\n            ? \"bvid=\" + encodeURIComponent(src.id)\n            : \"aid=\" + encodeURIComponent(src.id);\n\n          script.src = \"https://api.bilibili.com/x/web-interface/view?\" + q +\n            \"&jsonp=jsonp&callback=\" + encodeURIComponent(cb) +\n            \"&_=\" + Date.now();\n\n          document.head.appendChild(script);\n        });\n      }\n\n      function svg(name) {\n        var p = {\n          play: '<path d=\"m8 5v14l11-7z\"></path>',\n 