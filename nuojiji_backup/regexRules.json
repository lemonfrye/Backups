   }\n\n        body.innerHTML =\n          '<div class=\"bl-card\">' +\n            '<div class=\"bl-info\">' +\n              '<div class=\"bl-top\">' +\n                '<div class=\"bl-cover\">' +\n                  '<img src=\"' + esc(picHttps(meta.pic)) + '\" alt=\"\" referrerpolicy=\"no-referrer\">' +\n                  '<div class=\"bl-badge\">' + svg(\"play\") + '播放</div>' +\n                '</div>' +\n                '<div class=\"bl-main\">' +\n                  '<div class=\"bl-title\">' + esc(meta.title) + '</div>' +\n                  '<div class=\"bl-up\">up · ' + esc(meta.up || \"未知\") + '</div>' +\n                  '<div class=\"bl-stats\">' +\n                    '<span>' + svg(\"view\") + esc(fmt(meta.view)) + '</span>' +\n                    '<span>' + svg(\"dm\") + esc(fmt(meta.danmaku)) + '</span>' +\n                    '<span>' + svg(\"like\") + esc(fmt(meta.like)) + '</span>' +\n                  '</div>' +\n                '</div>' +\n              '</div>' +\n            '</div>' +\n            '<div class=\"bl-actions\">' +\n              '<button class=\"bl-btn primary\" data-act=\"chat\" type=\"button\">讲给ta听</button>' +\n              '<button class=\"bl-btn ghost\" data-act=\"change\" type=\"button\">换一个</button>' +\n            '</div>' +\n            (meta.desc ? '<div class=\"bl-desc\">' + esc(meta.desc) + '</div>' : '') +\n          '</div>';\n      }\n\n      function start(src) {\n        currentSource = src;\n        meta = null;\n\n        remember(src, sourceText(src));\n\n        stage.classList.remove(\"hidden\");\n        stage.innerHTML =\n          '<iframe src=\"' + esc(playerUrl(src)) + '\" scrolling=\"no\" frameborder=\"no\" allowfullscreen=\"true\" sandbox=\"allow-scripts allow-same-origin allow-presentation\"></iframe>';\n\n        changeBtn.classList.remove(\"hide\");\n\n        body.className = \"bl-body\";\n        body.innerHTML =\n          '<div class=\"bl-card\">' +\n            '<div class=\"bl-load\"><span class=\"bl-spin\"></span>正在读取视频信息...</div>' +\n          '</div>';\n\n        loadView(src)\n          .then(function (data) {\n            if (!data || data.code !== 0 || !data.data) throw new Error(\"view fail\");\n\n            var d = data.data;\n\n            meta = {\n              title: d.title || \"\",\n              up: (d.owner && d.owner.name) || \"\",\n              pic: d.pic || \"\",\n              view: (d.stat && d.stat.view) || 0,\n              danmaku: (d.stat && d.stat.danmaku) || 0,\n              like: (d.stat && d.stat.like) || 0,\n              desc: d.desc || \"\"\n            };\n\n            remember(src, meta.title || sourceText(src));\n            renderInfo();\n          })\n          .catch(function () {\n            meta = null;\n            renderInfo();\n          });\n      }\n\n      function renderMemoryHtml() {\n        var list = getRecent();\n\n        if (!list.length) return \"\";\n\n        return list.map(function (item, i) {\n          var label = item.title || sourceText(item);\n          var code = item.type === \"bvid\" ? item.id : \"av\" + item.id;\n          return '<button class=\"bl-memory\" type=\"button\" data-memory-index=\"' + i + '\">' +\n                   '<b>' + esc(label) + '</b>' +\n                   '<small>' + esc(code) + '</small>' +\n                 '</button>';\n        }).join(\"\");\n      }\n\n      function showPicker(prefill, msg) {\n        stage.classList.add(\"hidden\");\n        stage.innerHTML = \"\";\n        changeBtn.classList.add(\"hide\");\n        currentSource = null;\n        meta = null;\n\n        var memoryHtml = renderMemoryHtml();\n        var last = getLast();\n\n        body.className = \"bl-pick\";\n        body.innerHTML =\n          '<div class=\"bl-pick-card\">' +\n            '<div class=\"bl-pick-title\">' + svg(\"play\") + '置入 <span>链接</span> 或 <span>bv号</span></div>' +\n            '<div class=\"bl-row\">' +\n              '<input class=\"bl-input\" id=\"bl-input\" type=\"text\" placeholder=\"完整链接 / bv... / av...\" value=\"' + esc(prefill || \"\") + '\">' +\n              '<button class=\"bl-go\" id=\"bl-go\" type=\"button\">呈现</button>' +\n            '</div>' +\n            '<div class=\"bl-msg ' + (msg ? \"err\" : \"\") + '\" id=\"bl-msg\">' + esc(msg || \"\") + '</div>' +\n            '<div class=\"bl-memory-box\" id=\"bl-memory-box\" style=\"' + (memoryHtml ? \"display:block\" : \"display:none\") + '\">' +\n              '<div class=\"bl-memory-title\">记忆中的画面</div>' +\n              '<div class=\"bl-memory-list\">' + memoryHtml + '</div>' +\n            '</div>' +\n            '<div class=\"bl-hint\">' +\n              (last ? '已记住上次观看，点击记忆即可继续。' : '播放后会自动记住，下次空标签打开可继续。') +\n            '</div>' +\n          '</div>';\n\n        var input = document.getElementById(\"bl-input\");\n        var msgEl = document.getElementById(\"bl-msg\");\n        var go = document.getElementById(\"bl-go\");\n\n        function submit() {\n          var src = extract(input.value);\n          if (!src) {\n            msgEl.textContent = \"未能识别，请填入完整链接、bv号或av号。\";\n            msgEl.className = \"bl-msg err\";\n            return;\n          }\n          start(src);\n        }\n\n        go.addEventListener(\"click\", submit);\n        input.addEventListener(\"keydown\", function (e) {\n          if (e.key === \"Enter\") submit();\n        });\n      }\n\n      body.addEventListener(\"click\", function (e) {\n        var memoryBtn = e.target.closest(\"[data-memory-index]\");\n        if (memoryBtn) {\n          var index = Number(memoryBtn.getAttribute(\"data-memory-index\"));\n          var list = getRecent();\n          var item = list[index];\n          if (item) start(itemToSrc(item));\n          return;\n        }\n\n        var btn = e.target.closest(\"[data-act]\");\n        if (!btn) return;\n\n        var act = btn.getAttribute(\"data-act\");\n\n        if (act === \"chat\") {\n          fillInput();\n        } else if (act === \"change\") {\n          showPicker(\"\", \"\");\n        } else if (act === \"last\") {\n          var last = getLast();\n          if (last) start(itemToSrc(last));\n          else showPicker(\"\", \"\");\n        }\n      });\n\n      changeBtn.addEventListener(\"click\", function () {\n        showPicker(\"\", \"\");\n      });\n\n      var first = extract(injected);\n\n      if (first) {\n        start(first);\n      } else {\n        showPicker(\"\", \"\");\n      }\n    })();\n  </script>\n</body>\n</html>","cssScope":"","aiPrompt":"当对方在对话里给出了一个具体的影像来源(例如一段 bilibili 视频链接,或一个以 bv 开头的视频编号),而对方希望立刻观看、或希望你陪同观看时,你可以把这个来源原样安放进画面。\n你可以在对方想看视频时，或当你通过工具/检索查到了真实的视频编号(BV号)时开启窗口。\n1. 绝对不可凭空编造、猜测任何BV号！必须是你查到的、或对方给出的真实编号。\n2. 若无真实编号，请让窗口留空，由对方自己输入。\n\n绝对约束:\n1. 你只能使用对方真实给出过的视频链接或 bv 编号。\n2. 你绝不允许凭空编造、猜测或补全任何 bv 编号或链接。编造出的编号在画面里只会是无效的死链。\n3. 如果对方没有给出任何真实来源,就不要输出下面的标签,只用自然的语言回应。\n\n【输出格式（严格遵守）】\n在回复的最末尾，输出且仅输出一个全小写的标签，在此之后不可有任何文字：\n<bilibili>真实编号或链接</bilibili>\n\n格式示例（有真实编号时）：\n<bilibili>bv1gj411x7h7</bilibili>\n\n格式示例（无真实编号，留空让对方挑）：\n<bilibili></bilibili>\n\n【交流影片】\n当对方在消息中提到正在看某视频的标题或简介时，假装你也看到了这个画面，用自然的语气与对方交流感受，切勿提及任何技术或数据获取的细节。\n","parseMode":"text","renderMode":"iframe","scope":"global","characterIds":[],"scenes":["chat"],"role":"both","applyOnDisplay":1,"applyOnPrompt":0,"minDepth":null,"maxDepth":null,"trim":0,"order":0,"triggerEnabled":1,"triggerKeywords":"一起看,看,想看,视频,影片,影像,播放,刷,无聊,推荐,在看,bv,BV","createdAt":1787258026179,"updatedAt":1787258070399,"_id":2}]