dding: 1px 5px;\n      border-radius: 4px;\n      background: var(--primary);\n      color: #fff;\n      font-size: 8.5px;\n      font-weight: 700;\n    }\n\n    .bl-spacer {\n      flex: 1;\n    }\n\n    .bl-chip {\n      display: inline-flex;\n      align-items: center;\n      justify-content: center;\n      height: 22px;\n      padding: 0 10px;\n      border: 1px solid #e0e6ef;\n      border-radius: 999px;\n      background: #f4f7fb;\n      color: #3d4652;\n      font-size: 10.5px;\n      font-weight: 650;\n      cursor: pointer;\n      white-space: nowrap;\n    }\n\n    .bl-chip:active {\n      transform: scale(.96);\n    }\n\n    .bl-chip.hide {\n      display: none;\n    }\n\n    .bl-stage {\n      width: 100%;\n      height: 158px;\n      background: #000;\n    }\n\n    .bl-stage iframe {\n      display: block;\n      width: 100%;\n      height: 100%;\n      border: 0;\n    }\n\n    .bl-stage.hidden {\n      display: none;\n      height: 0;\n    }\n\n    .bl-body {\n      background: var(--bg);\n      padding: 7px 8px 9px;\n    }\n\n    .bl-card {\n      overflow: hidden;\n      border: 1px solid #f0f2f5;\n      border-radius: 9px;\n      background: #fff;\n      box-shadow: 0 1px 7px rgba(0,0,0,.025);\n    }\n\n    .bl-info {\n      padding: 8px 8px 0;\n    }\n\n    .bl-top {\n      display: flex;\n      gap: 8px;\n      min-width: 0;\n    }\n\n    .bl-cover {\n      position: relative;\n      width: 76px;\n      height: 48px;\n      flex-shrink: 0;\n      overflow: hidden;\n      border-radius: 6px;\n      background: #eef0f3;\n    }\n\n    .bl-cover img {\n      display: block;\n      width: 100%;\n      height: 100%;\n      object-fit: cover;\n    }\n\n    .bl-badge {\n      position: absolute;\n      left: 3px;\n      bottom: 3px;\n      display: inline-flex;\n      align-items: center;\n      gap: 2px;\n      padding: 1px 5px;\n      border-radius: 4px;\n      background: rgba(0,0,0,.58);\n      color: #fff;\n      font-size: 8.5px;\n      line-height: 